# ==========================================================================
# OCR Service — Environment Variable Template
# Copy this file to `.env` and fill in real values. NEVER commit a real `.env`.
# ==========================================================================

# --- General ---
HOST=127.0.0.1
PORT=8000
DEBUG=False

# --- Handwriting Recognition (HWR) ---
# Default provider: "textract" (Amazon Textract)
# Explicitly selectable alternatives: "paddleocr" (or "paddle"), "mock" (offline test mode), "azure", "google_vision"
HWR_PROVIDER=textract

# --- Amazon Textract (used when HWR_PROVIDER=textract) ---
# AWS region where Textract is hosted (e.g., us-east-1, us-west-2, eu-west-1)
AWS_REGION=us-east-1

# WARNING: NEVER put real AWS credentials (AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY,
# or AWS_SESSION_TOKEN) in this file, committed files, source code, logs, or test fixtures!
#
# AWS credentials are read from the standard AWS credential chain:
# - Environment variables in the active terminal session
# - ~/.aws/credentials and ~/.aws/config files
# - IAM instance profile / role
#
# How to configure temporary AWS Academy / Learner Lab credentials securely in terminal:
#
# PowerShell:
#   $env:AWS_ACCESS_KEY_ID="ASI..."
#   $env:AWS_SECRET_ACCESS_KEY="..."
#   $env:AWS_SESSION_TOKEN="IQo..."
#   $env:AWS_REGION="us-east-1"
#
# Bash / Linux / macOS:
#   export AWS_ACCESS_KEY_ID="ASI..."
#   export AWS_SECRET_ACCESS_KEY="..."
#   export AWS_SESSION_TOKEN="IQo..."
#   export AWS_REGION="us-east-1"
#
# NOTE ON AWS ACADEMY / LEARNER LAB:
# - Temporary session credentials expire after a few hours (typically 4 hours).
#   When they expire, refresh them in your terminal session before restarting the service.
# - Textract access depends on your IAM role's policy (ensure Textract:DetectDocumentText is allowed).

# --- Google Cloud Vision ---
# GOOGLE_CLOUD_PROJECT_ID is the Google Cloud project ID.
GOOGLE_CLOUD_PROJECT_ID=
# GOOGLE_APPLICATION_CREDENTIALS points to the local service-account JSON credential file. Never commit this file.
GOOGLE_APPLICATION_CREDENTIALS=
# GOOGLE_VISION_LANGUAGE_HINT should normally remain empty unless a specific language/handwriting hint is required.
GOOGLE_VISION_LANGUAGE_HINT=
GOOGLE_VISION_TIMEOUT_SECONDS=30

# --- Azure AI Document Intelligence (used when HWR_PROVIDER=azure) ---
# Create a "Document Intelligence" (a.k.a. Form Recognizer) resource in the
# Azure portal, then copy its Endpoint and one of its Keys below.
# Leave blank when using the mock provider.
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=
# Model id for text extraction. "prebuilt-read" handles printed + handwritten text.
AZURE_DOCUMENT_INTELLIGENCE_MODEL=prebuilt-read

# Overall per-page analysis timeout (seconds) for the Azure long-running operation.
AZURE_TIMEOUT=30.0

# --- Legacy Azure AI Vision Read v3.2 (deprecated, optional) ---
# Only needed if you deliberately fall back to the old REST integration.
AZURE_ENDPOINT=
AZURE_API_KEY=

# --- LLM Evaluation (unrelated to HWR; shown for completeness) ---
LLM_PROVIDER=mock
